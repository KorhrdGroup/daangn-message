# 이 파일을 .env.local 로 복사해서 값을 넣는다 (내 컴퓨터에서 npm run dev 할 때)
# 배포 때는 Vercel 프로젝트 Settings → Environment Variables 에 같은 이름으로 넣는다
# 값은 오피스(KorhrdGroupDB) .env 의 Supabase 주소·서비스 키와 같다 — 이 파일에 실제 값을 쓰지 않는다 (GitHub 에 올라간다)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 알리고 알림톡 (신청자 안내) — barosocial 과 같은 값. 알리고에 등록된 서버 IP 에서만 나간다
ALIGO_API_KEY=
ALIGO_USER_ID=
ALIGO_SENDER_KEY=
ALIGO_SENDER=
# (선택) 카페24 고정 IP 프록시 — 있으면 이쪽으로 보낸다
PROXY_URL=
PROXY_SECRET=
